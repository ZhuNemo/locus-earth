# 复制本文件为 keystore.properties 并改成你自己的值。
# keystore.properties 已被 .gitignore 忽略，不会入库。
#
# storeFile 支持两种写法：
#   · 相对路径：先按 app/ 目录解析，找不到再按 androidapk/ 目录解析
#   · 绝对路径：如 C:/keys/locus-earth.jks
#
# 文件不存在或 storeFile 指向的文件不存在时，assembleRelease 会自动回退到 debug 签名
# （能出包、能装机，但不能上架 Google Play），保证 CI 不因缺密钥而失败。

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=locus-earth
keyPassword=CHANGE_ME
