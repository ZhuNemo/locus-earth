<?xml version="1.0" encoding="utf-8"?>
<!--
  首次启动的全屏提示页（「这是一个网页应用」）。

  为什么从弹窗改成整页：
  · 双语文案在弹窗里可读性差 —— 弹窗宽度受限，中文正文在窄屏上会被挤成很多短行；
  · 整页可以把「中文标题 / 英文标题 / 中文正文 / 英文正文」按层级排开，
    不用再靠 HTML 的 <big><small> 模拟字号（旧的 dialog_welcome.xml 就是这么绕过去的）；
  · 两个按钮固定在底部，符合大家对「引导页」的认知，也不跟滚动文本抢空间。

  按钮文字为什么全部显式给色：
  Material 的按钮样式默认从主题继承 colorOnPrimary / colorPrimary。
  提示页是用户看到的第一屏，只要某层主题没解析到，文字就是同色而"消失"。
  这里 textColor / backgroundTint / strokeColor 三样都写死成 welcome_* 资源
  （见 values/colors.xml 与 values-night/colors.xml），不依赖继承链。

  系统栏：Activity 用的是 decorFitsSystemWindows=true（见 MainActivity.onCreate），
  内容区本来就落在状态栏/导航栏之内。所以这里**不要**加 fitsSystemWindows="true"，
  否则会拿已消费的 inset 再垫一次，底部按钮会被顶高一截。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/welcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/welcome_title_zh"
                android:textColor="@color/welcome_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/welcomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/welcome_title_en"
                android:textColor="@color/welcome_text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/welcomeBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/welcome_body_zh"
                android:textColor="@color/welcome_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/welcomeBodyEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.45"
                android:text="@string/welcome_body_en"
                android:textColor="@color/welcome_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部按钮条：两个按钮等宽，退出在左（次要，描边），进入在右（主行动，实心） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcomeExit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/welcome_exit"
            android:textColor="@color/welcome_button_outline_text"
            android:textSize="15sp"
            app:strokeColor="@color/welcome_button_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcomeEnter"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/welcome_enter"
            android:textColor="@color/welcome_button_primary_text"
            android:textSize="15sp"
            app:backgroundTint="@color/welcome_button_primary_bg" />
    </LinearLayout>
</LinearLayout>
