<?xml version="1.0" encoding="utf-8"?>
<!--
  壳的窗口底色。刻意跟网页自己的底色对齐，做到"启动页 → 网页首屏"没有色差跳变：
    · 浅色：网页的 theme-color meta 是 #ffffff
    · 深色：网页 CSS 变量 bg-primary 是 #0e1320（见仓库 css/themes.css）
  如果哪天网页换底色，改 shell_background 这两个值即可，不需要动 Kotlin 代码。
  （注意：XML 注释里不能出现连续两个 ASCII 连字符，所以上面没写 CSS 变量名全称。）
-->
<resources>
    <color name="shell_background">#FFFFFFFF</color>

    <!-- 导航栏颜色。API 24~26 上导航栏图标只能是浅色（windowLightNavigationBar 是 API 27 的
         属性），所以低版本给深色兜底；API 27+ 在 values-v27/colors.xml 里覆盖成白色。 -->
    <color name="shell_navbar">#FF0E1320</color>

    <!-- ================= 图标配色 =================
         桌面图标底：与 shell_navbar / shell_background(深色) 同一个深蓝黑，
         实心浅蓝圆盘压在上面，深浅色桌面上都清晰。 -->
    <color name="ic_launcher_background">#FF0E1320</color>

    <!-- 以下两色从 androidapk/icon-source 的 512 源图**实际采样**得到，
         用来重绘主题图标（monochrome）的线框矢量：
           brand_sky  = 海洋 #88C9F9
           brand_leaf = 陆地 #5C913B
         （早先的 #88C8F8 / #589038 是目测填的，与源图差 1~2 个色阶，已按实测修正。） -->
    <color name="brand_sky">#FF88C9F9</color>
    <color name="brand_leaf">#FF5C913B</color>

    <!-- ================= 首次启动全屏提示（浅色） =================
         这一组颜色**显式给值**，不写成 ?attr/colorOnPrimary 之类的主题属性。
         原因很具体：提示页是用户看到的第一屏，一旦某个 OEM 主题把
         onPrimary / onSurface 解析成透明或与背景同色，按钮文字就会"看不见"。
         取值对齐网页 css/themes.css 的 text-primary / accent-strong，
         让提示页和网页是同一套观感。 -->
    <color name="welcome_text">#FF101828</color>
    <color name="welcome_text_dim">#FF475467</color>
    <color name="welcome_button_primary_bg">#FF2563EB</color>
    <color name="welcome_button_primary_text">#FFFFFFFF</color>
    <color name="welcome_button_outline">#FFC7CDD6</color>
    <color name="welcome_button_outline_text">#FF101828</color>
</resources>
