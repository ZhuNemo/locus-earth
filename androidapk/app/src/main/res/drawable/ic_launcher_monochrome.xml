<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 的「主题图标」（monochrome 层）。

  为什么不能用桌面图标那套位图：
  主题图标只取 alpha 通道，由系统按用户的壁纸配色重新上色。
  新桌面图标是一张**实心圆盘**的位图，取 alpha 就是一枚纯色圆饼，
  上色后完全看不出是地球 —— 等于没有图形信息。
  所以这里保留**线框地球**矢量：描边版本取 alpha 后是一个地球轮廓，像地球。

  ⚠️ 已知的视觉不一致：桌面图标是实心绿蓝地球，主题图标是线框地球。
     两者只在「系统开了主题图标」时才并列出现，属于有意取舍。
     想统一的话，需要重画一个「只有轮廓、没有内部填充」的单色地球矢量。

  设计规则：viewBox 108×108，四周各留 18 单位会被系统裁掉，
  因此图形落在中间 66×66 的安全区内。这里地球直径 64（R=32），留 1 单位余量。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 地球外轮廓 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />

    <!-- 经线 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36.4,54 a17.6,32 0 1,0 35.2,0 a17.6,32 0 1,0 -35.2,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />

    <!-- 纬线 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M22,54 a32,17.6 0 1,0 64,0 a32,17.6 0 1,0 -64,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />

    <!-- 赤道 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M22,54 H86"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />
</vector>
