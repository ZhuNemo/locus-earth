<?xml version="1.0" encoding="utf-8"?>
<!--
  启动页图标：圆底 + 地球，跟桌面图标同一套视觉。
  为什么要有实心圆底：浅色模式下启动画面底色是白的，只画浅蓝的线几乎看不见；
  加上深色圆底后，白底和深底（深色模式下圆底与背景同色）都能看清。
  尺寸按 Android 12+ 启动画面的规则留了余量：可见区只取画布中间 2/3，
  所以这里圆底直径 66（R=33）、地球直径 52（R=26），都在安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M21,54 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0" />

    <path
        android:fillColor="#00000000"
        android:pathData="M28,54 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="2.8" />

    <path
        android:fillColor="#00000000"
        android:pathData="M39.7,54 a14.3,26 0 1,0 28.6,0 a14.3,26 0 1,0 -28.6,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="2.8" />

    <path
        android:fillColor="#00000000"
        android:pathData="M28,54 a26,14.3 0 1,0 52,0 a26,14.3 0 1,0 -52,0"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="2.8" />

    <path
        android:fillColor="#00000000"
        android:pathData="M28,54 H80"
        android:strokeColor="@color/brand_sky"
        android:strokeLineCap="round"
        android:strokeWidth="2.8" />
</vector>
